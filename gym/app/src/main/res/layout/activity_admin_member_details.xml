<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitness_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MEMBER DETAILS"
            android:textColor="@color/fitness_mint"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/memberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Member"
            android:textColor="@color/fitness_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/memberEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/fitness_text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/memberUid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/fitness_text_muted"
            android:textSize="10sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/fitness_surface"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/memberBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weight: — kg  •  Height: — cm"
                    android:textColor="@color/fitness_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/memberGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Goal: Not set"
                    android:textColor="@color/fitness_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ATTENDANCE HISTORY"
            android:textColor="@color/fitness_mint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/attendanceHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Loading..."
            android:textColor="@color/fitness_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="WORKOUT HISTORY"
            android:textColor="@color/fitness_mint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workoutHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Loading..."
            android:textColor="@color/fitness_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="WEIGHT HISTORY"
            android:textColor="@color/fitness_mint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weightHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Loading..."
            android:textColor="@color/fitness_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
