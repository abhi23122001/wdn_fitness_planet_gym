<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fitness_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WORKOUT" android:textColor="@color/fitness_mint" android:textSize="12sp" android:textStyle="bold" />
<TextView android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/fitness_text" android:textSize="29sp" android:textStyle="bold" />
<TextView android:id="@+id/detailMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/fitness_mint" android:textSize="12sp" android:textStyle="bold" />
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardBackgroundColor="@color/fitness_surface" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="19dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SESSION OVERVIEW" android:textColor="@color/fitness_mint" android:textSize="11sp" android:textStyle="bold" />
<TextView android:id="@+id/detailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/fitness_text_muted" android:textSize="14sp" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="EXERCISES" android:textColor="@color/fitness_text" android:textSize="13sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="01  •  Warm-up / mobility&#10;02  •  Main compound movement&#10;03  •  Secondary strength movement&#10;04  •  Isolation exercise&#10;05  •  Finisher / cooldown" android:textColor="@color/fitness_text_muted" android:textSize="14sp" android:lineSpacingExtra="8dp" />
<Button android:id="@+id/beginWorkoutButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:backgroundTint="@color/fitness_mint" android:text="BEGIN WORKOUT" android:textColor="@color/fitness_dark" android:textStyle="bold" android:stateListAnimator="@null" />
</LinearLayout></ScrollView>