<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/fitness_background" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="REPORTS &amp; ANALYTICS" android:textColor="@color/fitness_text"
        android:textSize="25sp" android:textStyle="bold"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp">
        <LinearLayout android:id="@+id/reportsContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>