<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/fitness_background" android:padding="18dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PAYMENT &amp; FEE MANAGEMENT" android:textColor="@color/fitness_text" android:textSize="25sp" android:textStyle="bold"/>
<TextView android:id="@+id/selectedPaymentMember" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No member selected" android:textColor="@color/fitness_mint" android:textSize="13sp"/>
<TextView android:id="@+id/paymentSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Total paid: ₹0.00 • Records: 0" android:textColor="@color/fitness_text_muted"/>
<EditText android:id="@+id/paymentAmount" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:hint="Amount (₹)" android:inputType="numberDecimal" android:textColor="@color/fitness_text" android:textColorHint="@color/fitness_text_muted"/>
<EditText android:id="@+id/paymentDate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Payment date (YYYY-MM-DD)" android:textColor="@color/fitness_text" android:textColorHint="@color/fitness_text_muted"/>
<EditText android:id="@+id/paymentMode" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Mode (Cash / UPI / Card / Bank)" android:textColor="@color/fitness_text" android:textColorHint="@color/fitness_text_muted"/>
<EditText android:id="@+id/paymentNote" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Note (optional)" android:textColor="@color/fitness_text" android:textColorHint="@color/fitness_text_muted"/>
<Button android:id="@+id/savePaymentButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:backgroundTint="@color/fitness_mint" android:text="SAVE PAYMENT" android:textColor="@color/fitness_dark" android:textStyle="bold"/>
<Button android:id="@+id/clearPaymentButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="CLEAR" android:textColor="@color/fitness_text"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="SELECT MEMBER" android:textColor="@color/fitness_text_muted" android:textStyle="bold"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"><LinearLayout android:id="@+id/paymentMemberContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
</LinearLayout>