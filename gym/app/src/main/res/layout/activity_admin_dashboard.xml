<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitness_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FITNESS PLANET"
            android:textColor="@color/fitness_mint"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ADMIN DASHBOARD"
            android:textColor="@color/fitness_text"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adminGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Welcome, Admin"
            android:textColor="@color/fitness_text_muted"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/fitness_green"
            app:cardCornerRadius="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADMIN ACCESS"
                    android:textColor="@color/fitness_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Manage members and monitor gym activity."
                    android:textColor="@color/fitness_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fitness_surface"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/totalMembers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fitness_mint"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEMBERS"
                        android:textColor="@color/fitness_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fitness_surface"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/totalAttendance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fitness_mint"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATTENDANCE"
                        android:textColor="@color/fitness_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/fitness_surface"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/totalWorkouts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/fitness_mint"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMPLETED WORKOUTS"
                    android:textColor="@color/fitness_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/membersButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="MANAGE MEMBERS"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/attendanceButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="ATTENDANCE MANAGEMENT"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/workoutManagementButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="WORKOUT MANAGEMENT"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/workoutMonitoringButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="WORKOUT MONITORING"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/reportsButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="REPORTS &amp; ANALYTICS"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_surface_2"
            android:text="ADMIN SETTINGS"
            android:textColor="@color/fitness_text"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/membershipButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="MEMBERSHIP MANAGEMENT"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/paymentButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="PAYMENT &amp; FEE MANAGEMENT"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/communityAdminButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_mint"
            android:text="COMMUNITY &amp; NOTIFICATIONS"
            android:textColor="@color/fitness_dark"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/refreshAdminButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_surface_2"
            android:text="REFRESH STATS"
            android:textColor="@color/fitness_text"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/memberDashboardButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fitness_surface_2"
            android:text="OPEN MEMBER VIEW"
            android:textColor="@color/fitness_text"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/fitness_surface_2"
            android:text="LOG OUT"
            android:textColor="@color/fitness_text"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>