<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fitness_planet_gym">

        <activity android:name=".WorkoutDetailActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".ProgressActivity" android:exported="false" />
        <activity android:name=".AttendanceActivity" android:exported="false" />
        <activity android:name=".WorkoutSessionActivity" android:exported="false" />
        <activity android:name=".WorkoutPlansActivity" android:exported="false" />
        <activity android:name=".DashboardActivity" android:exported="false" />
        <activity android:name=".AdminDashboardActivity" android:exported="false" />
        <activity android:name=".AdminMembersActivity" android:exported="false" />
        <activity android:name=".AdminMemberDetailsActivity" android:exported="false" />
        <activity android:name=".AdminAttendanceActivity" android:exported="false" />
        <activity android:name=".AdminWorkoutManagementActivity" android:exported="false" />
        <activity android:name=".AdminProgressActivity" android:exported="false" />
        <activity android:name=".AdminReportsActivity" android:exported="false" />
        <activity android:name=".AdminSettingsActivity" android:exported="false" />
        <activity android:name=".AdminMembershipActivity" android:exported="false" />
        <activity android:name=".AdminPaymentActivity" android:exported="false" />
        <activity android:name=".AdminCommunityActivity" android:exported="false" />
        <activity android:name=".CommunityActivity" android:exported="false" />
        <activity android:name=".NotificationsActivity" android:exported="false" />

        <service
            android:name=".FitnessPlanetMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>